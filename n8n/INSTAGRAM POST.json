    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are an expert social media content creator.\n\nPlatform: {{$json.platform}}\nTopic: {{$json.topic}}\nTone: {{$json.tone}}\nKeywords: {{$json.keywords}}\n\nGenerate:\n1. A catchy caption.\n2. Exactly 5 hashtags.\n3. A short CTA.\n\nReturn only valid JSON, no markdown fences, no extra text:\n\n{\n  \"caption\": \"...\",\n  \"hashtags\": \"#AI #Automation #Productivity #Tech #Innovation\",\n  \"cta\": \"Follow us for more AI updates!\"\n}",
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        -880,
        96
      ],
      "id": "205a26e1-6629-409e-819b-52e3ccdc1864",
      "name": "Basic LLM Chain"
    },
    {
      "parameters": {
        "model": "llama-3.3-70b-versatile",
        "options": {
          "maxTokensToSample": 5000,
          "temperature": 0.7
        }
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatGroq",
      "typeVersion": 1,
      "position": [
        -848,
        256
      ],
      "id": "23962aa0-7d28-48fc-8f3d-937a9233b7bf",
      "name": "Groq Chat Model",
      "credentials": {
        "groqApi": {
          "id": "Kdt4lS4JYJF9YO6L",
          "name": "Groq account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Defensive parse: strip markdown code fences if the LLM wrapped its JSON in ```json ... ```\nlet raw = $node[\"Basic LLM Chain\"].json.text.trim();\nraw = raw.replace(/^```(json)?/i, '').replace(/```$/, '').trim();\n\nlet data;\ntry {\n  data = JSON.parse(raw);\n} catch (e) {\n  throw new Error('Basic LLM Chain did not return valid JSON. Raw output: ' + raw);\n}\n\nconst caption = data.caption;\nconst hashtags = data.hashtags;\nconst cta = data.cta;\n\nconst finalPost = caption + \"\\n\\n\" + hashtags + \"\\n\\n\" + cta;\n\nreturn [\n  {\n    json: {\n      platform: $node[\"Select Platform\"].json.platform,\n      imageUrl: $node[\"Select Platform\"].json.imageUrl,\n      caption,\n      hashtags,\n      cta,\n      finalPost,\n      limit: 2200\n    }\n  }\n];"
      },
      "id": "9125e4f8-d23f-4995-8c8f-e0b044e0b73d",
      "name": "Merge Content & Check Limit",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -448,
        112
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 3
          },
          "conditions": [
            {
              "id": "too-long",
              "leftValue": "={{ $json.finalPost.length }}",
              "rightValue": "={{ $json.limit }}",
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "eabcbb81-1432-4e05-9ff3-d659d89afe02",
      "name": "Too Long?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        -224,
        112
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googlePalmApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ contents: [ { parts: [ { text: \"Shorten this social media post to under \" + $json.limit + \" characters while keeping the key message and hashtags:\\n\\n\" + $json.finalPost } ] } ] }) }}",
        "options": {
          "timeout": 20000
        }
      },
      "id": "da5cbd64-3b46-4320-8198-caa94f31acc5",
      "name": "Gemini - Shorten",
